<div id="progress-bar"></div>

<script>
	import { animate, createTimeline, stagger } from 'animejs';

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('.intro h1, .intro p, .post-item, article header h1').forEach(el => {
		el.style.opacity = '0';
	});

	if (prefersReduced) {
		document.documentElement.classList.add('no-anim');
	} else {
		requestAnimationFrame(() => {
			const tl = createTimeline({ defaults: { easing: 'outExpo' } });

			tl.add('.intro h1', {
				opacity: [0, 1],
				translateY: [24, 0],
				duration: 600,
			})
			.add('.intro p', {
				opacity: [0, 1],
				translateY: [16, 0],
				duration: 500,
			}, '-=350')
			.add('.post-item', {
				opacity: [0, 1],
				translateY: [28, 0],
				duration: 500,
				delay: stagger(100),
				easing: 'outQuad',
			}, '-=100');

			document.querySelectorAll('.posts li a').forEach(link => {
				link.addEventListener('mouseenter', () => {
					animate(link, {
						translateX: 4,
						duration: 300,
						easing: 'outQuad',
					});
				});
				link.addEventListener('mouseleave', () => {
					animate(link, {
						translateX: 0,
						duration: 300,
						easing: 'outQuad',
					});
				});
			});
		});
	}

	let ticking = false;
	const bar = document.getElementById('progress-bar');
	if (bar) {
		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					const h = document.documentElement;
					const scroll = h.scrollTop || document.body.scrollTop;
					const height = h.scrollHeight - h.clientHeight;
					const pct = height ? scroll / height : 0;
					bar.style.transform = `scaleX(${pct})`;
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });
	}
</script>

<style is:global>
	#progress-bar {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 1.5px;
		background: rgb(var(--black));
		transform-origin: left;
		transform: scaleX(0);
		z-index: 100;
		pointer-events: none;
	}

	.no-anim .intro h1,
	.no-anim .intro p,
	.no-anim .post-item,
	.no-anim article header h1 {
		opacity: 1 !important;
		transform: none !important;
	}

	.posts li a { text-decoration: none; color: inherit; }
	.posts li a:hover .post-title { opacity: 0.5; }
</style>
