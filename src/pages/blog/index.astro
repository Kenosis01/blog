---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Animate from '../../components/Animate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.back {
				display: inline-block;
				opacity: 0.5;
				text-decoration: none;
				font-size: 0.85em;
				margin-bottom: 2em;
			}
			.back:hover {
				opacity: 0.8;
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				margin-bottom: 2em;
			}
			.posts li a {
				text-decoration: none;
				color: inherit;
			}
			.posts li a:hover .post-title {
				opacity: 0.5;
			}
			.post-title {
				font-size: 1.15em;
				margin: 0 0 0.15em 0;
				line-height: 1.3;
				transition: opacity 0.15s;
			}
			.post-desc {
				margin: 0;
				opacity: 0.6;
				font-size: 0.9em;
			}
			.post-meta {
				margin: 0.2em 0 0 0;
				font-size: 0.75em;
				opacity: 0.5;
			}
		</style>
	</head>
	<body>
		<main>
			<a href="/" class="back">&larr; {SITE_TITLE}</a>
			<ul class="posts">
				{
					posts.map((post) => (
						<li class="post-item">
							<a href={`/blog/${post.id}/`}>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-desc">{post.data.description}</p>
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Animate />
		<footer>
			&copy; {new Date().getFullYear()} Tejash Raj
		</footer>
		<style>
			footer {
				padding: 4em 1em 3em 1em;
				text-align: center;
				font-size: 0.85em;
				opacity: 0.5;
			}
		</style>
	</body>
</html>
