---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Animate from '../components/Animate.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, BASE_PATH } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin-bottom: 1em;
			}
			.intro h1 {
				font-size: 1.3em;
				margin: 0 0 0.1em 0;
			}
			.intro .tagline {
				font-size: 0.9em;
				opacity: 0.5;
				margin: 0;
			}
			.line {
				border: none;
				border-top: 1px solid rgb(var(--accent));
				margin: 0 0 2em 0;
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts li {
				padding: 1.2em 0;
				border-bottom: 1px solid rgb(var(--accent));
			}
			.posts li:first-child {
				padding-top: 0;
			}
			.posts li a {
				text-decoration: none;
				color: inherit;
			}
			.posts li a:hover .post-title {
				opacity: 0.5;
			}
			.post-title {
				font-size: 1.15em;
				margin: 0 0 0.15em 0;
				line-height: 1.3;
				transition: opacity 0.15s;
			}
			.post-desc {
				margin: 0;
				opacity: 0.6;
				font-size: 0.9em;
			}
			.post-meta {
				margin: 0.2em 0 0 0;
				font-size: 0.75em;
				opacity: 0.5;
			}
		</style>
	</head>
	<body>
		<main>
			<div class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">Building things</p>
			</div>
			<hr class="line" />
			<ul class="posts">
				{
					posts.map((post) => (
						<li class="post-item">
							<a href={`${BASE_PATH}/${post.id}/`}>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-desc">{post.data.description}</p>
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Animate />
		<footer>
			&copy; {new Date().getFullYear()} Tejash Raj &mdash; <a href="https://buymeacoffee.com/kenosis" class="support">Buy me a coffee</a>
		</footer>
		<style>
			footer {
				padding: 4em 1em 3em 1em;
				text-align: center;
				font-size: 0.85em;
				opacity: 0.5;
			}
			.support {
				font-weight: 700;
				opacity: 1;
			}
		</style>
	</body>
</html>
